@{
    ViewData["Title"] = "STOIKO - Panel de Control";
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Montserrat:wght@700;800;900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <style>
        :root {
            --bg-dark: #0b0d10;
            --bg-card: #14171d;
            --bg-input: #1c2029;
            --bg-card-hover: #1c2029;
            --orange-primary: #FF5500;
            --orange-hover: #E04B00;
            --orange-glow: rgba(255, 85, 0, 0.25);
            --text-main: #FFFFFF;
            --text-muted: #94A3B8;
            --border-color: #222732;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            background-color: var(--bg-dark);
            color: var(--text-main);
            font-family: 'Inter', sans-serif;
            overflow-x: hidden;
            line-height: 1.6;
        }

        /* --- HEADER --- */
        .stoiko-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 1.2rem 3rem;
            background-color: rgba(11, 13, 16, 0.9);
            backdrop-filter: blur(12px);
            position: sticky;
            top: 0;
            z-index: 1000;
            border-bottom: 1px solid var(--border-color);
        }

        .stoiko-brand {
            font-family: 'Montserrat', sans-serif;
            font-size: 2rem;
            font-weight: 900;
            letter-spacing: 4px;
            color: var(--orange-primary);
            text-transform: uppercase;
            text-decoration: none;
            text-shadow: 0 0 12px var(--orange-glow);
        }

        .user-welcome {
            display: flex;
            align-items: center;
            gap: 1rem;
            color: var(--text-muted);
            font-size: 0.95rem;
            font-weight: 500;
        }

            .user-welcome span {
                color: var(--text-main);
                font-weight: 700;
            }

        .btn-logout-icon {
            background-color: var(--bg-card);
            border: 1px solid var(--border-color);
            color: var(--text-muted);
            padding: 0.5rem 0.9rem;
            border-radius: 8px;
            text-decoration: none;
            font-size: 1rem;
            transition: all 0.3s ease;
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }

            .btn-logout-icon:hover {
                background-color: rgba(255, 77, 77, 0.15);
                border-color: #FF4D4D;
                color: #FF4D4D;
            }

        /* --- LAYOUT CONTENEDOR --- */
        .stoiko-container {
            display: flex;
            min-height: calc(100vh - 80px);
        }

        /* --- SIDEBAR --- */
        .scrum-sidebar {
            width: 280px;
            background-color: var(--bg-card);
            border-right: 1px solid var(--border-color);
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            position: sticky;
            top: 80px;
            height: calc(100vh - 80px);
            overflow-y: auto;
        }

            .scrum-sidebar::-webkit-scrollbar {
                display: none;
            }

        .sidebar-top {
            padding: 1.5rem 0;
        }

        .scrum-sidebar-title {
            font-size: 0.75rem;
            text-transform: uppercase;
            color: var(--text-muted);
            letter-spacing: 1.5px;
            font-weight: 800;
            padding: 0 1.5rem;
            margin-bottom: 0.8rem;
            display: block;
        }

        .scrum-menu {
            display: flex;
            flex-direction: column;
            gap: 0.3rem;
            padding: 0 1rem;
            margin-bottom: 1.5rem;
        }

        .scrum-menu-item {
            display: flex;
            align-items: center;
            gap: 1.2rem;
            padding: 0.85rem 1.2rem;
            color: var(--text-muted);
            text-decoration: none;
            font-weight: 600;
            font-size: 0.95rem;
            border-radius: 12px;
            transition: all 0.3s ease;
        }

            .scrum-menu-item i {
                font-size: 1.2rem;
                transition: color 0.3s ease;
            }

            .scrum-menu-item:hover {
                background-color: var(--bg-card-hover);
                color: var(--text-main);
            }

                .scrum-menu-item:hover i {
                    color: var(--orange-primary);
                }

            .scrum-menu-item.active {
                background-color: var(--orange-primary);
                color: #FFFFFF;
                box-shadow: 0 4px 15px var(--orange-glow);
            }

                .scrum-menu-item.active i {
                    color: #FFFFFF;
                }

        /* --- CONTENIDO PRINCIPAL --- */
        .content-area {
            flex: 1;
            padding: 3rem;
            max-width: 1200px;
            margin: 0 auto;
        }

        .hero-banner {
            text-align: center;
            margin-bottom: 3.5rem;
            background: linear-gradient(180deg, var(--bg-card) 0%, rgba(20, 23, 29, 0.4) 100%);
            border: 1px solid var(--border-color);
            border-radius: 20px;
            padding: 3rem 2rem;
            box-shadow: 0 20px 40px rgba(0,0,0,0.4);
        }

            .hero-banner h1 {
                font-family: 'Montserrat', sans-serif;
                font-size: 2.5rem;
                font-weight: 900;
                text-transform: uppercase;
                letter-spacing: 2px;
                margin-bottom: 0.5rem;
            }

            .hero-banner p {
                color: var(--text-muted);
                font-size: 1.1rem;
            }

        /* --- GRID DE TARJETAS CON EFECTO DOBLE CLIC --- */
        .cards-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
            gap: 2rem;
            margin-bottom: 4rem;
        }

        .stoiko-card {
            background-color: var(--bg-card);
            border: 1px solid var(--border-color);
            border-radius: 16px;
            overflow: hidden;
            transition: all 0.3s ease;
            display: flex;
            flex-direction: column;
        }

            .stoiko-card:hover {
                border-color: var(--orange-primary);
                transform: translateY(-5px);
                box-shadow: 0 10px 30px var(--orange-glow);
            }

        .card-image-container {
            position: relative;
            height: 200px;
            overflow: hidden;
            cursor: pointer;
        }

            .card-image-container img {
                width: 100%;
                height: 100%;
                object-fit: cover;
                transition: transform 0.5s ease;
            }

            .card-image-container:hover img {
                transform: scale(1.05);
            }

        .zoom-hint {
            position: absolute;
            bottom: 10px;
            right: 10px;
            background-color: rgba(0, 0, 0, 0.7);
            color: var(--text-main);
            padding: 0.3rem 0.6rem;
            font-size: 0.75rem;
            border-radius: 6px;
            pointer-events: none;
            backdrop-filter: blur(4px);
            border: 1px solid rgba(255,255,255,0.1);
        }

        .card-body {
            padding: 1.8rem;
            display: flex;
            flex-direction: column;
            gap: 0.8rem;
            flex: 1;
        }

        .card-icon-title {
            display: flex;
            align-items: center;
            gap: 0.8rem;
            color: var(--orange-primary);
            font-size: 1.3rem;
        }

        .card-title {
            font-family: 'Montserrat', sans-serif;
            font-size: 1.2rem;
            font-weight: 800;
            color: var(--text-main);
        }

        .card-desc {
            color: var(--text-muted);
            font-size: 0.92rem;
            line-height: 1.5;
        }

        /* --- MODAL PARA EXPANDIR IMAGEN CON DOBLE CLIC --- */
        .image-modal {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background-color: rgba(11, 13, 16, 0.92);
            backdrop-filter: blur(10px);
            z-index: 2000;
            justify-content: center;
            align-items: center;
            padding: 2rem;
            animation: fadeIn 0.3s ease;
        }

        .image-modal-content {
            background-color: var(--bg-card);
            border: 1.5px solid var(--orange-primary);
            border-radius: 20px;
            max-width: 800px;
            width: 100%;
            overflow: hidden;
            box-shadow: 0 25px 60px rgba(255, 85, 0, 0.3);
            position: relative;
            animation: scaleUp 0.3s ease;
        }

            .image-modal-content img {
                width: 100%;
                max-height: 450px;
                object-fit: cover;
            }

        .image-modal-body {
            padding: 2rem;
        }

        .image-modal-close {
            position: absolute;
            top: 15px;
            right: 15px;
            background-color: rgba(0,0,0,0.6);
            color: var(--text-main);
            border: none;
            width: 40px;
            height: 40px;
            border-radius: 50%;
            font-size: 1.2rem;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: all 0.3s ease;
            z-index: 10;
        }

            .image-modal-close:hover {
                background-color: var(--orange-primary);
            }

        @@keyframes fadeIn {
            from {
                opacity: 0;
            }

            to {
                opacity: 1;
            }
        }

        @@keyframes scaleUp {
            from {
                transform: scale(0.9);
                opacity: 0;
            }

            to {
                transform: scale(1);
                opacity: 1;
            }
        }
    </style>
</head>
<body>

    <header class="stoiko-header">
        <a href="#" class="stoiko-brand">STOIKO</a>

        <div class="user-welcome">
            <span>Atleta: @Context.Session.GetString("UserEmail")</span>
            <a asp-controller="Home" asp-action="Logout" class="btn-logout-icon" title="Cerrar Sesión">
                <i class="bi bi-box-arrow-right"></i> Salir
            </a>
        </div>
    </header>

    <div class="stoiko-container">

        <!-- SIDEBAR DE NAVEGACIÓN -->
        <aside class="scrum-sidebar">
            <div class="sidebar-top">
                <span class="scrum-sidebar-title">Dashboard</span>
                <nav class="scrum-menu">
                    <a asp-controller="Home" asp-action="Index" class="scrum-menu-item active">
                        <i class="bi bi-house-door-fill"></i> Inicio
                    </a>
                    <a asp-controller="Home" asp-action="Perfil_usu" class="scrum-menu-item">
                        <i class="bi bi-grid-fill"></i> Mi Perfil
                    </a>
                </nav>

                <span class="scrum-sidebar-title">Entrenamiento</span>
                <nav class="scrum-menu">
                    <a href="#" class="scrum-menu-item">
                        <i class="bi bi-lightning-charge-fill"></i> Ejercicios
                    </a>
                    <a href="#" class="scrum-menu-item">
                        <i class="bi bi-diagram-3-fill"></i> Grupos Musculares
                    </a>
                    <a href="#" class="scrum-menu-item">
                        <i class="bi bi-collection-fill"></i> Divisiones
                    </a>
                </nav>

                <span class="scrum-sidebar-title">Rendimiento</span>
                <nav class="scrum-menu">
                    <a href="#" class="scrum-menu-item">
                        <i class="bi bi-journal-check"></i> Historial
                    </a>
                    <a href="#" class="scrum-menu-item">
                        <i class="bi bi-bar-chart-line-fill"></i> Progreso
                    </a>
                </nav>
            </div>
        </aside>

        <!-- CONTENIDO PRINCIPAL -->
        <main class="content-area">

            <div class="hero-banner">
                <h1>Panel Principal</h1>
                <p>Control, disciplina y seguimiento en tu entrenamiento diario[cite: 11]</p>
            </div>

            <div style="text-align: center; margin-bottom: 2.5rem;">
                <h2 style="font-family: 'Montserrat', sans-serif; font-size: 1.8rem; font-weight: 800; text-transform: uppercase; margin-bottom: 0.5rem;">
                    ¿De qué trata <span style="color: var(--orange-primary);">Stoiko</span>?
                </h2>
                <p style="color: var(--text-muted);">Una plataforma enfocada en estructurar tu progreso físico sin distracciones[cite: 11]. *(Tip: Haz **doble clic** en cualquier imagen para expandirla)*.</p>
            </div>

            <!-- TARJETAS CON IMÁGENES INTERACTIVAS -->
            <div class="cards-grid">

                <!-- Tarjeta 1 -->
                <div class="stoiko-card">
                    <div class="card-image-container" ondblclick="openModal('https://images.unsplash.com/photo-1517838277536-f5f99be501cd?q=80&w=800&auto=format&fit=crop', 'Tus Ejercicios', 'Organiza tu biblioteca de ejercicios personalizados repetición por repetición.')">
                        <img src="https://images.unsplash.com/photo-1517838277536-f5f99be501cd?q=80&w=600&auto=format&fit=crop" alt="Ejercicios">
                        <span class="zoom-hint"><i class="bi bi-arrows-fullscreen"></i> Doble clic para ampliar</span>
                    </div>
                    <div class="card-body">
                        <div class="card-icon-title">
                            <i class="bi bi-lightning-charge-fill"></i>
                            <h3 class="card-title">Tus Ejercicios</h3>
                        </div>
                        <p class="card-desc">Organiza tu biblioteca de ejercicios personalizados estableciendo rutinas de fuerza óptimas.</p>
                    </div>
                </div>

                <!-- Tarjeta 2 -->
                <div class="stoiko-card">
                    <div class="card-image-container" ondblclick="openModal('https://images.unsplash.com/photo-1534438327276-14e5300c3a48?q=80&w=800&auto=format&fit=crop', 'División Muscular', 'Clasifica tus rutinas por grupos musculares (pecho, espalda, pierna, etc.) de forma estructurada.')">
                        <img src="https://images.unsplash.com/photo-1534438327276-14e5300c3a48?q=80&w=600&auto=format&fit=crop" alt="División Muscular">
                        <span class="zoom-hint"><i class="bi bi-arrows-fullscreen"></i> Doble clic para ampliar</span>
                    </div>
                    <div class="card-body">
                        <div class="card-icon-title">
                            <i class="bi bi-diagram-3-fill"></i>
                            <h3 class="card-title">División Muscular</h3>
                        </div>
                        <p class="card-desc">Clasifica tus rutinas por grupos musculares (pecho, espalda, pierna) maximizando la hipertrofia.</p>
                    </div>
                </div>

                <!-- Tarjeta 3 -->
                <div class="stoiko-card">
                    <div class="card-image-container" ondblclick="openModal('https://images.unsplash.com/photo-1540497077202-7c8a3999166f?q=80&w=800&auto=format&fit=crop', 'Perfil y Avance', 'Mapea tu constancia a lo largo del tiempo, revisa tu historial de marcas y estadísticas.')">
                        <img src="https://images.unsplash.com/photo-1540497077202-7c8a3999166f?q=80&w=600&auto=format&fit=crop" alt="Perfil y Avance">
                        <span class="zoom-hint"><i class="bi bi-arrows-fullscreen"></i> Doble clic para ampliar</span>
                    </div>
                    <div class="card-body">
                        <div class="card-icon-title">
                            <i class="bi bi-person-badge-fill"></i>
                            <h3 class="card-title">Perfil y Avance</h3>
                        </div>
                        <p class="card-desc">Mapea tu constancia a lo largo del tiempo, revisa tu historial de marcas y crecimiento físico.</p>
                    </div>
                </div>

            </div>

        </main>
    </div>

    <!-- MODAL DE VISUALIZACIÓN EXPANDIDA -->
    <div id="imageModal" class="image-modal" onclick="closeModalOnOutside(event)">
        <div class="image-modal-content">
            <button class="image-modal-close" onclick="closeModal()"><i class="bi bi-x-lg"></i></button>
            <img id="modalImg" src="" alt="Vista ampliada">
            <div class="image-modal-body">
                <h3 id="modalTitle" style="font-family: 'Montserrat', sans-serif; font-size: 1.5rem; font-weight: 800; color: var(--orange-primary); margin-bottom: 0.5rem;"></h3>
                <p id="modalDesc" style="color: var(--text-muted); font-size: 1rem;"></p>
            </div>
        </div>
    </div>

    <!-- SCRIPTS PARA EL DOBLE CLIC Y MODAL -->
    <script>
        function openModal(imgSrc, title, desc) {
            document.getElementById('modalImg').src = imgSrc;
            document.getElementById('modalTitle').textContent = title;
            document.getElementById('modalDesc').textContent = desc;
            document.getElementById('imageModal').style.display = 'flex';
        }

        function closeModal() {
            document.getElementById('imageModal').style.display = 'none';
        }

        function closeModalOnOutside(event) {
            const modalContent = document.querySelector('.image-modal-content');
            if (event.target.id === 'imageModal') {
                closeModal();
            }
        }
    </script>

</body>
</html>