@{
    ViewData["Title"] = "STOIKO - Iniciar Sesión";
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Montserrat:wght@700;800;900&display=swap" rel="stylesheet">

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <script src="https://unpkg.com/react@18/umd/react.production.min.js" crossorigin="anonymous"></script>
    <script src="https://unpkg.com/react-dom@18/umd/react-dom.production.min.js" crossorigin="anonymous"></script>
    <!-- Escape en @@babel para evitar errores de compilación Razor -->
    <script src="https://unpkg.com/@@babel/standalone/babel.min.js"></script>

    <style>
        :root {
            --bg-dark: #0b0d10;
            --bg-card: #14171d;
            --bg-input: #1c2029;
            --bg-card-hover: #1c2029;
            --orange-primary: #FF5500;
            --orange-hover: #E04B00;
            --orange-glow: rgba(255, 85, 0, 0.25);
            --text-main: #FFFFFF;
            --text-muted: #94A3B8;
            --border-color: #222732;
            --error-color: #FF4D4D;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            background-color: var(--bg-dark);
            color: var(--text-main);
            font-family: 'Inter', sans-serif;
            overflow-x: hidden;
            line-height: 1.6;
        }

        .stoiko-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 1.2rem 3rem;
            background-color: rgba(11, 13, 16, 0.9);
            backdrop-filter: blur(12px);
            position: sticky;
            top: 0;
            z-index: 1000;
            border-bottom: 1px solid var(--border-color);
        }

        .stoiko-brand {
            font-family: 'Montserrat', sans-serif;
            font-size: 2rem;
            font-weight: 900;
            letter-spacing: 4px;
            color: var(--orange-primary);
            text-transform: uppercase;
            text-decoration: none;
            text-shadow: 0 0 12px var(--orange-glow);
        }

        .auth-buttons {
            display: flex;
            gap: 1rem;
            align-items: center;
        }

        .btn-stoiko-outline {
            color: var(--text-main);
            border: 1.5px solid var(--border-color);
            padding: 0.6rem 1.4rem;
            border-radius: 6px;
            font-weight: 600;
            font-size: 0.95rem;
            text-decoration: none;
            transition: all 0.3s ease;
        }

        .btn-stoiko-outline:hover {
            border-color: var(--orange-primary);
            color: var(--orange-primary);
        }

        .btn-stoiko-primary {
            background-color: var(--orange-primary);
            color: #FFFFFF;
            padding: 0.65rem 1.6rem;
            border-radius: 6px;
            font-weight: 700;
            font-size: 0.95rem;
            text-decoration: none;
            box-shadow: 0 4px 15px var(--orange-glow);
            transition: all 0.3s ease;
        }

        .btn-stoiko-primary:hover {
            background-color: var(--orange-hover);
            transform: translateY(-2px);
        }

        .stoiko-container {
            display: flex;
            min-height: calc(100vh - 80px);
        }

        /* --- SIDEBAR PRO (ESTILO CODINGLAB) --- */
        .scrum-sidebar {
            width: 280px;
            background-color: var(--bg-card);
            border-right: 1px solid var(--border-color);
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            position: sticky;
            top: 80px;
            height: calc(100vh - 80px);
            overflow-y: auto;
        }

        .scrum-sidebar::-webkit-scrollbar {
            display: none;
        }

        .sidebar-top {
            padding: 1.5rem 0;
        }

        .scrum-sidebar-title {
            font-size: 0.75rem;
            text-transform: uppercase;
            color: var(--text-muted);
            letter-spacing: 1.5px;
            font-weight: 800;
            padding: 0 1.5rem;
            margin-bottom: 0.8rem;
            display: block;
        }

        .scrum-menu {
            display: flex;
            flex-direction: column;
            gap: 0.3rem;
            padding: 0 1rem;
            margin-bottom: 1.5rem;
        }

        .scrum-menu-item {
            display: flex;
            align-items: center;
            gap: 1.2rem;
            padding: 0.85rem 1.2rem;
            color: var(--text-muted);
            text-decoration: none;
            font-weight: 600;
            font-size: 0.95rem;
            border-radius: 12px;
            transition: all 0.3s ease;
        }

        .scrum-menu-item i {
            font-size: 1.2rem;
            transition: color 0.3s ease;
        }

        .scrum-menu-item:hover {
            background-color: var(--bg-card-hover);
            color: var(--text-main);
        }

        .scrum-menu-item:hover i {
            color: var(--orange-primary);
        }

        .scrum-menu-item.active {
            background-color: var(--orange-primary);
            color: #FFFFFF;
            box-shadow: 0 4px 15px var(--orange-glow);
        }

        .scrum-menu-item.active i {
            color: #FFFFFF;
        }

        .profile-details {
            background-color: #0f1115;
            padding: 1.2rem 1.5rem;
            display: flex;
            align-items: center;
            justify-content: space-between;
            border-top: 1px solid var(--border-color);
            margin-top: auto;
        }

        .profile-content {
            display: flex;
            align-items: center;
            gap: 1rem;
        }

        .profile-avatar {
            width: 42px;
            height: 42px;
            background: linear-gradient(135deg, var(--orange-primary), var(--orange-hover));
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #fff;
            font-size: 1.3rem;
            font-weight: bold;
        }

        .name-job {
            display: flex;
            flex-direction: column;
        }

        .profile_name {
            color: var(--text-main);
            font-size: 0.95rem;
            font-weight: 700;
        }

        .job {
            color: var(--text-muted);
            font-size: 0.8rem;
            font-weight: 500;
        }

        .log_out {
            color: var(--text-muted);
            font-size: 1.4rem;
            cursor: pointer;
            transition: color 0.3s ease;
            text-decoration: none;
        }

        .log_out:hover {
            color: var(--orange-primary);
        }

        .content-area {
            flex: 1;
            padding: 3rem;
            max-width: 1200px;
            margin: 0 auto;
        }

        .login-section {
            display: flex;
            justify-content: center;
            align-items: center;
            margin-bottom: 4rem;
            padding-top: 2rem;
        }

        .login-card {
            background-color: var(--bg-card);
            border: 1px solid var(--border-color);
            border-radius: 20px;
            width: 100%;
            max-width: 440px;
            padding: 2.8rem 2.2rem;
            box-shadow: 0 20px 50px rgba(0, 0, 0, 0.6);
        }

        .brand-header {
            text-align: center;
            margin-bottom: 2rem;
        }

        .brand-subtitle {
            font-size: 0.95rem;
            color: var(--text-muted);
            margin-top: 0.4rem;
        }

        .form-group {
            margin-bottom: 1.4rem;
        }

        .form-label {
            display: block;
            font-size: 0.85rem;
            font-weight: 600;
            color: var(--text-muted);
            margin-bottom: 0.5rem;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .input-wrapper {
            position: relative;
            display: flex;
            align-items: center;
        }

        .input-icon {
            position: absolute;
            left: 1.2rem;
            color: var(--text-muted);
            font-size: 1.1rem;
            pointer-events: none;
        }

        .form-control {
            width: 100%;
            background-color: var(--bg-input);
            border: 1.5px solid var(--border-color);
            border-radius: 10px;
            padding: 0.85rem 1.2rem 0.85rem 3rem;
            color: var(--text-main);
            font-size: 0.95rem;
            outline: none;
            transition: all 0.3s ease;
        }

        .form-control:focus {
            border-color: var(--orange-primary);
            box-shadow: 0 0 12px var(--orange-glow);
        }

        .captcha-box {
            background-color: var(--bg-input);
            border: 1px dashed var(--border-color);
            border-radius: 12px;
            padding: 1rem;
            margin-bottom: 1.5rem;
        }

        .captcha-display {
            display: flex;
            align-items: center;
            justify-content: space-between;
            background-color: #0b0d10;
            border: 1px solid var(--border-color);
            border-radius: 8px;
            padding: 0.6rem 1rem;
            margin-bottom: 0.8rem;
        }

        .captcha-code {
            font-family: 'Montserrat', monospace;
            font-size: 1.4rem;
            font-weight: 800;
            letter-spacing: 6px;
            color: var(--orange-primary) !important;
            user-select: none;
        }

        .btn-refresh-captcha {
            background: transparent;
            border: none;
            color: var(--text-muted);
            font-size: 1.2rem;
            cursor: pointer;
            transition: color 0.3s ease;
        }

        .btn-refresh-captcha:hover {
            color: var(--orange-primary);
        }

        .btn-submit {
            width: 100%;
            background-color: var(--orange-primary);
            color: #FFFFFF;
            border: none;
            padding: 0.9rem;
            border-radius: 10px;
            font-family: 'Montserrat', sans-serif;
            font-size: 1rem;
            font-weight: 800;
            text-transform: uppercase;
            letter-spacing: 1px;
            cursor: pointer;
            box-shadow: 0 6px 20px var(--orange-glow);
            transition: all 0.3s ease;
        }

        .btn-submit:hover {
            background-color: var(--orange-hover);
            transform: translateY(-2px);
        }

        .alert-error {
            background-color: rgba(255, 77, 77, 0.15);
            border: 1px solid var(--error-color);
            color: var(--error-color);
            padding: 0.8rem 1rem;
            border-radius: 8px;
            font-size: 0.88rem;
            margin-bottom: 1.2rem;
            text-align: center;
        }

        .card-footer-text {
            text-align: center;
            margin-top: 1.8rem;
            font-size: 0.9rem;
            color: var(--text-muted);
        }

        .card-footer-text a {
            color: var(--orange-primary);
            font-weight: 700;
            text-decoration: none;
        }

        .react-bits-section {
            background: linear-gradient(180deg, var(--bg-card) 0%, rgba(255,85,0,0.06) 100%);
            border: 1px dashed var(--orange-primary);
            border-radius: 16px;
            padding: 3.5rem 2rem;
            text-align: center;
            scroll-margin-top: 100px;
        }

        .react-bits-badge {
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
            background-color: rgba(255, 85, 0, 0.15);
            color: var(--orange-primary);
            padding: 0.4rem 1.2rem;
            border-radius: 20px;
            font-weight: 700;
            font-size: 0.85rem;
            margin-bottom: 1.5rem;
            text-transform: uppercase;
            letter-spacing: 1px;
        }

        #react-bits-root {
            margin-top: 2rem;
        }
    </style>
</head>
<body>

    <header class="stoiko-header">
        <a asp-controller="Home" asp-action="Index" class="stoiko-brand">STOIKO</a>

        <div class="auth-buttons">
            <a asp-controller="Home" asp-action="iniciar_ses" class="btn-stoiko-outline">Iniciar sesión</a>
            <a asp-controller="Home" asp-action="registrousuario" class="btn-stoiko-primary">Crear cuenta</a>
        </div>
    </header>

    <div class="stoiko-container">

        <aside class="scrum-sidebar">
            <div class="sidebar-top">
                <span class="scrum-sidebar-title">Dashboard</span>
                <nav class="scrum-menu">
                    <a href="#login" class="scrum-menu-item active">
                        <i class="bi bi-grid-fill"></i> Mi Perfil
                    </a>
                    <a asp-controller="Home" asp-action="Index" class="scrum-menu-item">
                        <i class="bi bi-house-door-fill"></i> Inicio
                    </a>
                </nav>

                <span class="scrum-sidebar-title">Entrenamiento</span>
                <nav class="scrum-menu">
                    <a href="#ejercicios" class="scrum-menu-item">
                        <i class="bi bi-lightning-charge-fill"></i> Ejercicios
                    </a>
                    <a href="#musculos" class="scrum-menu-item">
                        <i class="bi bi-diagram-3-fill"></i> Grupos Musculares
                    </a>
                    <a href="#divisiones" class="scrum-menu-item">
                        <i class="bi bi-collection-fill"></i> Divisiones
                    </a>
                </nav>

                <span class="scrum-sidebar-title">Rendimiento</span>
                <nav class="scrum-menu">
                    <a href="#registros" class="scrum-menu-item">
                        <i class="bi bi-journal-check"></i> Historial
                    </a>
                    <a href="#progreso" class="scrum-menu-item">
                        <i class="bi bi-bar-chart-line-fill"></i> Progreso
                    </a>
                </nav>

                <span class="scrum-sidebar-title">Sistema</span>
                <nav class="scrum-menu">
                    <a href="#react-bits" class="scrum-menu-item">
                        <i class="bi bi-cpu-fill"></i> React Bits
                    </a>
                </nav>
            </div>

            <div class="profile-details">
                <div class="profile-content">
                    <div class="profile-avatar">
                        <i class="bi bi-person-fill"></i>
                    </div>
                    <div class="name-job">
                        <div class="profile_name">Usuario</div>
                        <div class="job">Nivel 1 • Atleta</div>
                    </div>
                </div>
                <a asp-controller="Home" asp-action="Index" class="log_out" title="Cerrar sesión">
                    <i class="bi bi-box-arrow-right"></i>
                </a>
            </div>
        </aside>

        <main class="content-area">

            <section id="login" class="login-section">
                <div class="login-card">

                    <div class="brand-header">
                        <h2 style="font-family: 'Montserrat', sans-serif; font-size: 2rem; font-weight: 900; color: var(--text-main); text-transform: uppercase;">Iniciar Sesión</h2>
                        <p class="brand-subtitle">Ingresa tus credenciales y demuestra tu disciplina</p>
                    </div>

                    @if (ViewBag.ErrorMessage != null)
                    {
                        <div class="alert-error">
                            <i class="bi bi-exclamation-triangle-fill"></i> @ViewBag.ErrorMessage
                        </div>
                    }

                    <!-- CORREGIDO: Apunta a "iniciar_ses" que es el método HttpPost que autentica -->
                    <form asp-controller="Home" asp-action="iniciar_ses" method="post" id="loginForm">

                        @Html.AntiForgeryToken()

                        <div class="form-group">
                            <label for="email" class="form-label">Correo Electrónico</label>
                            <div class="input-wrapper">
                                <input type="email" id="email" name="email" class="form-control" placeholder="ejemplo@stoiko.com" required />
                                <i class="bi bi-envelope-fill input-icon"></i>
                            </div>
                        </div>

                        <div class="form-group">
                            <label for="password" class="form-label">Contraseña</label>
                            <div class="input-wrapper">
                                <input type="password" id="password" name="password" class="form-control" placeholder="••••••••" required />
                                <i class="bi bi-lock-fill input-icon"></i>
                            </div>
                        </div>

                        <div class="captcha-box">
                            <label class="form-label">Verificación de Seguridad</label>
                            <div class="captcha-display">
                                <span id="captchaText" class="captcha-code"></span>
                                <button type="button" class="btn-refresh-captcha" id="refreshCaptcha" title="Generar otro código">
                                    <i class="bi bi-arrow-clockwise"></i>
                                </button>
                            </div>
                            <div class="input-wrapper">
                                <input type="text" id="captchaInput" name="captchaInput" class="form-control" placeholder="Ingresa el código" required style="padding-left: 1.2rem;" />

                                <input type="hidden" id="ExpectedCaptcha" name="ExpectedCaptcha" value="" />
                            </div>
                        </div>

                        <button type="submit" class="btn-submit">Ingresar</button>

                    </form>

                    <div class="card-footer-text">
                        ¿No tienes una cuenta? <a asp-controller="Home" asp-action="registrousuario">Regístrate</a>
                    </div>
                </div>
            </section>

            <section id="react-bits" class="react-bits-section">
                <div class="react-bits-badge">
                    <i class="bi bi-stars"></i> Componentes Dinámicos
                </div>
                <h2 style="font-family: 'Montserrat', sans-serif; font-size: 2.2rem; font-weight: 800; text-transform: uppercase; margin-bottom: 1rem;">
                    Implementado con <span style="color: var(--orange-primary);">React Bits</span>
                </h2>
                <p style="color: var(--text-muted); max-width: 600px; margin: 0 auto 1.5rem auto;">
                    Componentes interactivos de alta frecuencia renderizados dentro de tu infraestructura de C# / ASP.NET Core MVC.
                </p>

                <div id="react-bits-root"></div>
            </section>

        </main>
    </div>

    <!-- SCRIPT PURO PARA EL CAPTCHA -->
    <script>
        function generateCaptcha() {
            const chars = 'ABCDEFGHJKLMNPQRSTUVWXYZ23456789';
            let captcha = '';
            for (let i = 0; i < 5; i++) {
                captcha += chars.charAt(Math.floor(Math.random() * chars.length));
            }

            const captchaTextEl = document.getElementById('captchaText');
            const expectedCaptchaEl = document.getElementById('ExpectedCaptcha');

            if (captchaTextEl) captchaTextEl.textContent = captcha;
            if (expectedCaptchaEl) expectedCaptchaEl.value = captcha;

            return captcha;
        }

        document.addEventListener("DOMContentLoaded", function() {
            generateCaptcha();
            const refreshBtn = document.getElementById('refreshCaptcha');
            if (refreshBtn) {
                refreshBtn.addEventListener('click', generateCaptcha);
            }
        });
    </script>

    <!-- SCRIPT DE REACT BITS -->
    <script type="text/babel">
        function ReactBitsBanner() {
            const [hovered, setHovered] = React.useState(false);

            const containerStyle = {
                display: 'inline-block',
                padding: '1.5rem 3rem',
                backgroundColor: '#0b0d10',
                border: hovered ? '1.5px solid #FF5500' : '1.5px solid #222732',
                borderRadius: '12px',
                boxShadow: hovered ? '0 0 25px rgba(255, 85, 0, 0.3)' : 'none',
                transition: 'all 0.3s ease',
                cursor: 'pointer'
            };

            const textStyle = {
                fontFamily: 'Montserrat, sans-serif',
                fontSize: '1.4rem',
                fontWeight: '900',
                letterSpacing: '3px',
                color: hovered ? '#FF5500' : '#FFFFFF',
                transition: 'color 0.3s ease'
            };

            return (
                <div
                    style={containerStyle}
                    onMouseEnter={() => setHovered(true)}
                    onMouseLeave={() => setHovered(false)}
                >
                    <div style={textStyle}>
                        ⚡ STOIKO x REACT BITS COMPONENT ⚡
                    </div>
                    <small style={{ color: '#94A3B8', marginTop: '5px', display: 'block', fontSize: '0.8rem' }}>
                        (Pasa el cursor para activar el efecto interactivo)
                    </small>
                </div>
            );
        }

        const rootElement = document.getElementById('react-bits-root');
        const root = ReactDOM.createRoot(rootElement);
        root.render(<ReactBitsBanner />);
    </script>

</body>
</html>