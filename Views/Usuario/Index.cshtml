@model IEnumerable<stoiko3.Models.Usuario>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.EmailUsu)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.PasswordUsu)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.FechaRegistro)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.FechaInicioSecion)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(model => item.EmailUsu)
            </td>
            <td>
                @Html.DisplayFor(model => item.PasswordUsu)
            </td>
            <td>
                @Html.DisplayFor(model => item.FechaRegistro)
            </td>
            <td>
                @Html.DisplayFor(model => item.FechaInicioSecion)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.IdUsu">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.IdUsu">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.IdUsu">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
