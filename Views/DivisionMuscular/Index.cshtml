@model IEnumerable<stoiko3.Models.DivisionMuscular>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.NomDiv)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.ScoreDm)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(model => item.NomDiv)
            </td>
            <td>
                @Html.DisplayFor(model => item.ScoreDm)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.IdDm">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.IdDm">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.IdDm">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
